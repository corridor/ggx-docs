const initials = (name: string) =>
  name
    .split(/[\s()&]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => w[0].toUpperCase())
    .join("");
---

<div class="ggx-integrations not-content">
  {
    groups.map((group) => (
      <section class="ggx-int-group">
        <h3 class="ggx-int-title">
          {group.href ? <a href={base + group.href}>{group.title}</a> : group.title}
          <span class="ggx-int-count">{group.items.length}</span>
        </h3>
        <ul class="ggx-int-grid">
          {group.items.map((item) => (
            <li>
              <a class="ggx-int-tile" href={base + item.href}>
                <span class="ggx-int-logo" aria-hidden="true">
                  {item.logo ? (
                    <img src={item.logo} alt="" width="32" height="32" loading="lazy" decoding="async" />
                  ) : item.icon ? (
                    <Icon name={item.icon} size="1.75rem" />
                  ) : (
                    <span class="ggx-int-initials">{initials(item.name)}</span>
                  )}
                </span>
                <span class="ggx-int-name">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .ggx-integrations {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-block: 1.5rem 2.5rem;
  }
  .ggx-int-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: var(--sl-text-h4);
    color: var(--sl-color-white);
  }
  .ggx-int-title a {
    color: inherit;
    text-decoration: none;
  }
  .ggx-int-title a:hover {
    color: var(--sl-color-accent-high);
  }
  .ggx-int-count {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
  .ggx-int-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
    gap: 0.75rem;
  }
  .ggx-int-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 7rem;
    padding: 1rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-gray-7, var(--sl-color-black));
    color: var(--sl-color-gray-1);
    text-align: center;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .ggx-int-tile:hover,
  .ggx-int-tile:focus-visible {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.12);
  }
  .ggx-int-logo {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    /* A light chip keeps dark logos readable in the dark theme. */
    background: #fff;
    color: #111;
  }
  .ggx-int-logo img {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }
  .ggx-int-initials {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--sl-color-accent);
  }
  .ggx-int-name {
    font-size: var(--sl-text-sm);
    line-height: 1.25;
  }
  @media (max-width: 30rem) {
    .ggx-int-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
