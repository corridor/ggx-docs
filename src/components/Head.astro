---
import Default from "@astrojs/starlight/components/Head.astro";
import headingFont from "@fontsource/newsreader/files/newsreader-latin-400-normal.woff2?url";
import bodyFont from "@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url";

const SITE_NAME = "GenGuardX Docs";
const ORGANIZATION = { "@type": "Organization", name: "GenGuardX", url: "https://genguardx.ai/" };

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const home = new URL(base, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname.replace(/\/?$/, "/"), Astro.site).href;
const isHome = pageUrl === home;
const socialImage = new URL("og.png", home).href;
const markdownUrl = new URL("index.md", pageUrl).href;
const topic = Astro.locals.starlightSidebarTopics?.topics.find((item) => item.isCurrent);

const website = { "@type": "WebSite", name: SITE_NAME, url: home };

const breadcrumbs = [
  { name: "Docs", item: home },
  ...(topic && topic.label !== title
    ? [{ name: topic.label, item: new URL(topic.link.replace(/^\//, ""), home).href }]
    : []),
  { name: title, item: pageUrl },
];

// FAQ questions are the page's h3 headings; the text up to the next heading is the answer.
const plainText = (markdown: string) =>
  markdown
    .replace(/^<[\s\S]*?>\s*$/gm, "")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[*_`]/g, "")
    .replace(/^\s*(?:[-*]|\d+\.)\s+/gm, "")
    .replace(/\s+/g, " ")
    .trim();
const faq =
  entry.id === "faq"
    ? (entry.body ?? "")
        .split(/^### /m)
        .slice(1)
        .map((block) => {
          const [question, ...rest] = block.split("\n");
          return {
            "@type": "Question",
            name: question.trim(),
            acceptedAnswer: {
              "@type": "Answer",
              text: plainText(rest.join("\n").split(/^## /m)[0]),
            },
          };
        })
    : [];

const graph = isHome
  ? [{ ...website, description, publisher: ORGANIZATION }, ORGANIZATION]
  : [
      {
        "@type": "TechArticle",
        headline: title,
        description,
        url: pageUrl,
        image: socialImage,
        inLanguage: "en",
        ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
        isPartOf: website,
        publisher: ORGANIZATION,
      },
      {
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          ...crumb,
        })),
      },
      ...(faq.length ? [{ "@type": "FAQPage", mainEntity: faq }] : []),
    ];
const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replace(
  /</g,
  "\\u003c",
);
---

<Default><slot /></Default>
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={socialImage} />
<!-- Point crawlers and AI agents at the plain Markdown version of this page. -->
<link rel="alternate" type="text/markdown" href={markdownUrl} />
<!-- Heading and body faces are above the fold on every page; preload them to avoid a late swap. -->
<link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
<script is:inline type="application/ld+json" set:html={jsonLd} />
